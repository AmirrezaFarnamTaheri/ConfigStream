# EditorConfig: https://editorconfig.org
# Codifies the repository's existing conventions (LF endings, 4-space indent,
# trimmed trailing whitespace) so editors enforce them automatically and the
# trailing-whitespace cleanup does not regress.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.md]
# Markdown uses trailing whitespace for hard line breaks; do not strip it.
trim_trailing_whitespace = false

[*.{woff,woff2,png,jpg,jpeg,gif,ico,svg}]
# Binary/vendored assets: do not impose text rules.
trim_trailing_whitespace = false
insert_final_newline = false

[Makefile]
indent_style = tab
