{
  "name": "configstream-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "ConfigStream frontend build and E2E tooling",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test:frontend:no-network": "node scripts/frontend_same_origin_smoke.cjs",
    "test:frontend:degraded": "node scripts/frontend_same_origin_smoke.cjs --no-js-only",
    "test:frontend:browser": "python scripts/run_test_profile.py frontend-browser",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmirrezaFarnamTaheri/ConfigStream.git"
  },
  "license": "AGPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/AmirrezaFarnamTaheri/ConfigStream/issues"
  },
  "homepage": "https://github.com/AmirrezaFarnamTaheri/ConfigStream#readme",
  "devDependencies": {
    "playwright": "^1.56.1",
    "vite": "^6.3.5"
  }
}
