# SPDX-License-Identifier: AGPL-3.0-or-later
# .dockerignore — Exclude unnecessary files from Docker build context
# to reduce image size and avoid cache invalidation.

# Version control
.git/
.gitattributes
.gitignore

# Output & data directories
output/
output*/
data/

# Canonical source batches are not shipped. The generated admission manifest
# is bundled as package data under src/configstream/data/.
sources/

# Build artifacts
build/
frontend-dist/

# Node.js
node_modules/

# Python caches
__pycache__/
*.pyc
*.pyo
*.cache
.pytest_cache/
.mypy_cache/
.hypothesis/

# Tests (not needed in production image)
tests/

# Documentation and meta-files (preserve build cache)
.github/
docs/
scripts/
*.md

# Environment & config
.env*

# Ignore large generated files
ping*_vpn_detailed.csv
ping*_vpn_report.json
ping*_vpn_singbox.json
ping*_vpn_subscription_base64.txt
ping*_vpn_subscription_raw.txt

# Local development
.idea/
.vscode/
*.swp
*.swo
*~
