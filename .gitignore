# Build Artifacts (Intermediate)
output_batch_*/
data/
*.zip
*.log
dist/
build/
*.egg-info/

# Dependencies & System
node_modules/
__pycache__/
venv/
.venv
.env
.DS_Store

# Cache files
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.hypothesis/

# Python generated files
*.py[cod]

# Prevent DB locking artifacts and binary blobs
data/*.db
data/*.db-shm
data/*.db-wal
data/*.mmdb
data/*.json

# Prevent output bloat in source history
output/
reports/

# Logs
*.log

# Docker volumes
output/
data/
# Exceptions
!data/.gitkeep
!output/.gitkeep
output_batch_*/
