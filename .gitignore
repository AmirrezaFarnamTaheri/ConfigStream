# Build Artifacts (Intermediate)
output_batch_*/
data/
*.zip
dist/
build/
*.egg-info/

# Dependencies & System
node_modules/
__pycache__/
venv/
.venv
.env
.DS_Store

# Cache files
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.hypothesis/
.tmp/
*.lock

# Python generated files
*.py[cod]

# Go build artifacts
src/go/tester/tester
*.exe
*.dll
*.so
*.dylib

# Prevent DB locking artifacts and binary blobs
data/*.db
data/*.db-shm
data/*.db-wal
data/*.mmdb
data/*.json

# Prevent output bloat in source history
reports/
sources/backup_dynamic/

# Logs
*.log

# Pipeline runtime artifacts
consolidated_sources.txt
# TLS keylog artifacts (e.g., SSLKEYLOGFILE=...)
sslkeylog*
false

# Docker volumes
data/
# Exceptions
!data/.gitkeep
!output/.gitkeep
src/go/tester/configstream-tester
*.wasm
verification_build/
