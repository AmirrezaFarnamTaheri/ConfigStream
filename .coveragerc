[run]
source = src/configstream
omit =
    */test*.py
    */__pycache__/*
    */tools/*
    # Genuinely dead code: no import site anywhere under src/ or tests/ as of
    # this writing. Re-check with `grep -rn <module>` before adding a module
    # here — auto_detect.py, dns_cache.py, http_client.py, and serialize.py
    # were previously (and incorrectly) listed alongside these; all four are
    # imported by production code (the core parser dispatcher, DNS/SNI
    # pinning, the HTTP client, and output serialization respectively) and
    # must stay covered.
    */diskqueue.py
    */etag_cache.py
    */freshness.py
    */sharding.py
    */geoip_offline.py
    */__main__.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == "__main__":
    if TYPE_CHECKING:
    @abstractmethod
