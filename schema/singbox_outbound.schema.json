{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConfigStream Intermediate Sing-box Outbound",
  "description": "Validates converter-stage outbound objects before release finalization. Public sing-box files are complete root objects and are validated separately; finalization migrates legacy WireGuard outbounds to modern sing-box endpoints.",
  "type": "object",
  "required": [
    "type",
    "tag"
  ],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "direct",
        "dns",
        "block",
        "selector",
        "urltest",
        "vless",
        "vmess",
        "trojan",
        "shadowsocks",
        "hysteria2",
        "tuic",
        "wireguard",
        "http",
        "socks"
      ]
    },
    "tag": {
      "type": "string",
      "minLength": 1
    },
    "server": {
      "type": "string",
      "minLength": 1
    },
    "server_port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "uuid": {
      "type": "string",
      "minLength": 1
    },
    "flow": {
      "type": "string"
    },
    "password": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "private_key": {
      "type": "string",
      "minLength": 1
    },
    "peer_public_key": {
      "type": "string",
      "minLength": 1
    },
    "local_address": {
      "type": "string",
      "minLength": 1
    },
    "local_address_v6": {
      "type": "string",
      "minLength": 1
    },
    "pre_shared_key": {
      "type": "string",
      "minLength": 1
    },
    "mtu": {
      "type": "integer"
    },
    "reserved": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "outbounds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tls": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "server_name": {
          "type": "string"
        },
        "insecure": {
          "type": "boolean"
        },
        "alpn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "utls": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "fingerprint": {
              "type": "string"
            }
          }
        }
      }
    },
    "transport": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "vless",
              "vmess",
              "trojan",
              "shadowsocks",
              "hysteria2",
              "tuic",
              "wireguard",
              "http",
              "socks"
            ]
          }
        }
      },
      "then": {
        "required": [
          "server",
          "server_port"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "vless",
              "vmess"
            ]
          }
        }
      },
      "then": {
        "required": [
          "uuid"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "trojan",
              "hysteria2"
            ]
          }
        }
      },
      "then": {
        "required": [
          "password"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "shadowsocks"
          }
        }
      },
      "then": {
        "required": [
          "method",
          "password"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "tuic"
          }
        }
      },
      "then": {
        "required": [
          "uuid",
          "password"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "wireguard"
          }
        }
      },
      "then": {
        "required": [
          "private_key",
          "peer_public_key",
          "local_address",
          "mtu"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "selector",
              "urltest"
            ]
          }
        }
      },
      "then": {
        "required": [
          "outbounds"
        ]
      }
    }
  ]
}
