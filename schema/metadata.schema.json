{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConfigStream Metadata",
  "description": "Canonical pipeline analytics metadata consumed by frontend and tooling.",
  "type": "object",
  "required": [
    "schema_version",
    "version",
    "generated_at",
    "last_updated_utc",
    "trace_id",
    "proxies_snapshot_hash",
    "previous_proxies_snapshot_hash",
    "total_lines_sourced",
    "total_unique_candidates",
    "total_valid_proxies",
    "total_proxies",
    "total_tested",
    "total_working",
    "success_rate",
    "latency_distribution",
    "protocols",
    "country_stats",
    "drop_reasons",
    "rejection_reasons",
    "asns",
    "total_revived",
    "total_clean",
    "total_smart_chains",
    "smart_chain_count",
    "chain_outbounds_count",
    "backpressure_drop",
    "revived_warp",
    "revived_vwarp",
    "warp_attempts",
    "vwarp_attempts",
    "vwarp_success",
    "vwarp_win_rate",
    "washing_enabled",
    "shielded_count",
    "shielded_candidate_count",
    "shielded_verified_count",
    "evasion_utls_enabled",
    "evasion_alpn_enabled",
    "evasion_fragmentation_enabled",
    "evasion_multiplexing_enabled",
    "evasion_dns_safe_count",
    "evasion_dns_hardened_count",
    "duration_seconds",
    "geo_resolved",
    "cache_misses",
    "final_count",
    "time_limited",
    "time_limit_seconds",
    "total_configured_sources",
    "fetched_sources",
    "sources_count",
    "total_sources",
    "update_interval_hours",
    "latency_by_country",
    "latency_by_protocol",
    "chosen_subset_size",
    "pipeline_execution_audit"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_updated_utc": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^([A-Za-z0-9_-]{1,32}|-)$"
    },
    "proxies_snapshot_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "previous_proxies_snapshot_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "start_time": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "end_time": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "update_interval_hours": {
      "type": "integer",
      "minimum": 1
    },
    "total_lines_sourced": {
      "type": "integer",
      "minimum": 0
    },
    "total_unique_candidates": {
      "type": "integer",
      "minimum": 0
    },
    "total_valid_proxies": {
      "type": "integer",
      "minimum": 0
    },
    "total_proxies": {
      "type": "integer",
      "minimum": 0
    },
    "logical_total_proxies": {
      "type": "integer",
      "minimum": 0
    },
    "total_tested": {
      "type": "integer",
      "minimum": 0
    },
    "total_working": {
      "type": "integer",
      "minimum": 0
    },
    "logical_total_working": {
      "type": "integer",
      "minimum": 0
    },
    "public_record_count": {
      "type": "integer",
      "minimum": 0
    },
    "public_working_count": {
      "type": "integer",
      "minimum": 0
    },
    "total_clean": {
      "type": "integer",
      "minimum": 0
    },
    "total_revived": {
      "type": "integer",
      "minimum": 0
    },
    "total_dirty": {
      "type": "integer",
      "minimum": 0
    },
    "total_smart_chains": {
      "type": "integer",
      "minimum": 0
    },
    "success_rate": {
      "type": "number",
      "minimum": 0
    },
    "vwarp_win_rate": {
      "type": "number",
      "minimum": 0
    },
    "washing_enabled": {
      "type": "boolean"
    },
    "revived_warp": {
      "type": "integer",
      "minimum": 0
    },
    "revived_vwarp": {
      "type": "integer",
      "minimum": 0
    },
    "warp_attempts": {
      "type": "integer",
      "minimum": 0
    },
    "vwarp_attempts": {
      "type": "integer",
      "minimum": 0
    },
    "vwarp_success": {
      "type": "integer",
      "minimum": 0
    },
    "washer_success_count": {
      "type": "integer",
      "minimum": 0
    },
    "scanner_ips_found": {
      "type": "integer",
      "minimum": 0
    },
    "smart_chain_count": {
      "type": "integer",
      "minimum": 0
    },
    "smart_chains_breakdown": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "chain_outbounds_count": {
      "type": "integer",
      "minimum": 0
    },
    "backpressure_drop": {
      "type": "integer",
      "minimum": 0
    },
    "shielded_count": {
      "type": "integer",
      "minimum": 0
    },
    "shielded_candidate_count": {
      "type": "integer",
      "minimum": 0
    },
    "shielded_verified_count": {
      "type": "integer",
      "minimum": 0
    },
    "evasion_utls_enabled": {
      "type": "integer",
      "minimum": 0
    },
    "evasion_alpn_enabled": {
      "type": "integer",
      "minimum": 0
    },
    "evasion_fragmentation_enabled": {
      "type": "integer",
      "minimum": 0
    },
    "evasion_multiplexing_enabled": {
      "type": "integer",
      "minimum": 0
    },
    "evasion_dns_safe_count": {
      "type": "integer",
      "minimum": 0
    },
    "evasion_dns_hardened_count": {
      "type": "integer",
      "minimum": 0
    },
    "protocols": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "country_stats": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "countries": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "asns": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "isp_stats": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "drop_reasons": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "rejection_reasons": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "latency_distribution": {
      "type": "object",
      "required": [
        "fast",
        "medium",
        "slow",
        "very_slow"
      ],
      "properties": {
        "fast": {
          "type": "integer",
          "minimum": 0
        },
        "medium": {
          "type": "integer",
          "minimum": 0
        },
        "slow": {
          "type": "integer",
          "minimum": 0
        },
        "very_slow": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "latency_by_country": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "latency_by_protocol": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "duration": {
      "type": "number",
      "minimum": 0
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "geo_resolved": {
      "type": "integer",
      "minimum": 0
    },
    "cache_misses": {
      "type": "integer",
      "minimum": 0
    },
    "final_count": {
      "type": "integer",
      "minimum": 0
    },
    "time_limited": {
      "type": "boolean"
    },
    "time_limit_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "total_configured_sources": {
      "type": "integer",
      "minimum": 0
    },
    "fetched_sources": {
      "type": "integer",
      "minimum": 0
    },
    "sources_count": {
      "type": "integer",
      "minimum": 0
    },
    "total_sources": {
      "type": "integer",
      "minimum": 0
    },
    "fetched_lines": {
      "type": "integer",
      "minimum": 0
    },
    "parsed": {
      "type": "integer",
      "minimum": 0
    },
    "tested": {
      "type": "integer",
      "minimum": 0
    },
    "working": {
      "type": "integer",
      "minimum": 0
    },
    "chosen_subset_size": {
      "type": "integer",
      "minimum": 0
    },
    "pipeline_execution_audit": {
      "type": "object",
      "required": [
        "trace_id",
        "tested",
        "working",
        "total_revived",
        "revived_warp",
        "revived_vwarp",
        "revival_attempts",
        "revival_win_rate",
        "fetched_sources",
        "total_sources",
        "source_toxicity_rate",
        "backpressure_drop",
        "time_limited"
      ],
      "properties": {
        "trace_id": {
          "type": "string",
          "pattern": "^([A-Za-z0-9_-]{1,32}|-)$"
        },
        "tested": {
          "type": "integer",
          "minimum": 0
        },
        "working": {
          "type": "integer",
          "minimum": 0
        },
        "total_revived": {
          "type": "integer",
          "minimum": 0
        },
        "revived_warp": {
          "type": "integer",
          "minimum": 0
        },
        "revived_vwarp": {
          "type": "integer",
          "minimum": 0
        },
        "revival_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "revival_win_rate": {
          "type": "number",
          "minimum": 0
        },
        "fetched_sources": {
          "type": "integer",
          "minimum": 0
        },
        "total_sources": {
          "type": "integer",
          "minimum": 0
        },
        "source_toxicity_rate": {
          "type": "number",
          "minimum": 0
        },
        "backpressure_drop": {
          "type": "integer",
          "minimum": 0
        },
        "time_limited": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "chain_obs_count": {
      "type": "integer",
      "description": "Alias for chain_outbounds_count; number of unique chain outbound tags."
    }
  },
  "additionalProperties": false
}
