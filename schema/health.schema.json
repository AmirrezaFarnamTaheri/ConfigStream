{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConfigStream Public Health",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "generated_at",
    "trace_id",
    "total_working",
    "total_tested",
    "schema_validated",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0", "2.0"]
    },
    "status": {
      "type": "string",
      "enum": ["ok", "degraded", "failed"]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": "string"
    },
    "source_commit": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "run_attempt": {
      "type": "string"
    },
    "total_working": {
      "type": "integer",
      "minimum": 0
    },
    "total_tested": {
      "type": "integer",
      "minimum": 0
    },
    "source_coverage": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "schema_validated": {
      "type": "boolean"
    },
    "native_clients_validated": {
      "type": "boolean"
    },
    "release_blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "native_report": {
      "type": "string",
      "minLength": 1
    },
    "native_report_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {"const": "2.0"}
        },
        "required": ["schema_version"]
      },
      "then": {
        "required": [
          "source_coverage",
          "native_clients_validated",
          "release_blockers"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {"const": "2.0"},
          "status": {"const": "ok"}
        },
        "required": ["schema_version", "status"]
      },
      "then": {
        "required": ["native_report", "native_report_sha256"],
        "properties": {
          "schema_validated": {"const": true},
          "native_clients_validated": {"const": true},
          "release_blockers": {"maxItems": 0},
          "total_working": {"minimum": 1}
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {"const": "2.0"},
          "status": {"const": "failed"}
        },
        "required": ["schema_version", "status"]
      },
      "then": {
        "properties": {
          "release_blockers": {"minItems": 1}
        }
      }
    }
  ],
  "additionalProperties": false
}
