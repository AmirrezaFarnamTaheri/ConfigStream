{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConfigStream Proxy",
  "type": "object",
  "required": ["protocol", "address", "port"],
  "properties": {
    "id": {"type": "string", "description": "Stable proxy identifier (UUID or hash)"},
    "config": {"type": "string"},
    "protocol": {"type": "string", "minLength": 1},
    "address": {"type": "string", "minLength": 1},
    "port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "uuid": {"type": "string"},
    "remarks": {"type": "string"},
    "country": {"type": "string"},
    "country_code": {"type": "string"},
    "city": {"type": "string"},
    "asn": {"type": "string"},
    "isp": {"type": "string"},
    "org": {"type": "string"},
    "latency": {"type": ["number", "null"]},
    "is_working": {"type": "boolean"},
    "is_secure": {"type": "boolean"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "last_checked": {"type": "string"},
    "source": {"type": ["string", "null"]},
    "security": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string"}
      }
    },
    "security_issues": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string"}
      }
    },
    "tested_at": {"type": "string"},
    "details": {
      "type": "object",
      "additionalProperties": true
    },
    "throughput_kbps": {"type": ["integer", "null"]},
    "dns_over_https_ok": {"type": ["boolean", "null"]},
    "age_seconds": {"type": "integer"},
    "stale": {"type": "boolean"},
    "scores": {
      "type": "object",
      "additionalProperties": {"type": "number"}
    },
    "process": {"type": "string", "description": "Processing type: native, washed, revived-warp, revived-vwarp, chain, shielded"},
    "history": {"type": ["array", "null"], "items": {"type": "number"}, "description": "Historical latency values for sparklines"}
  },
  "additionalProperties": true
}
