{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConfigStream Artifact Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "artifact_generated_at",
    "trace_id",
    "file_count",
    "total_size_bytes",
    "files"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "artifact_generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": "string"
    },
    "source_commit": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "run_attempt": {
      "type": "string"
    },
    "file_count": {
      "type": "integer",
      "minimum": 0
    },
    "total_size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "size_bytes", "sha256", "category"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "category": {
            "type": "string",
            "enum": [
              "control",
              "api",
              "frontend",
              "docs",
              "analytics",
              "side-product",
              "subscription"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
