# =============================================================================
# ConfigStream Environment Configuration
# =============================================================================
# Copy this file to .env and configure for your environment
# Documentation: https://github.com/AmirrezaFarnamTaheri/ConfigStream#configuration

# =============================================================================
# API Server Configuration
# =============================================================================

# Admin API Key (required for production /api/admin/* endpoints)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
#ADMIN_API_KEY=your-secure-admin-key-here

# CORS Configuration
# Comma-separated list of allowed origins for API access.
# Production should list exact origins only.
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000,http://127.0.0.1:8000

# CORS Regex Pattern (development/test only). Production startup rejects regex
# CORS to avoid trusting arbitrary wildcard domains.
#ALLOWED_ORIGIN_REGEX=

# Browser credentialed CORS. Keep false unless a specific deployment requires
# cookies or browser-managed credentials.
CORS_ALLOW_CREDENTIALS=false

# WebSocket update channel lifecycle limits
WS_MAX_CONNECTIONS=100
WS_IDLE_TIMEOUT_SECONDS=60
WS_SEND_TIMEOUT_SECONDS=5

# Lab live chain testing
# Disabled by default in production. If enabled in production, ADMIN_API_KEY is
# required in the request payload and the endpoint remains rate/size limited.
LAB_LIVE_TEST_ENABLED=false
LAB_TEST_TIMEOUT_SECONDS=15
LAB_MAX_CONFIG_BYTES=65536

# Environment Type (affects API key requirements)
# Options: development, ci, test, production
ENVIRONMENT=development

# =============================================================================
# Test Configuration
# =============================================================================

TEST_TIMEOUT=10
FETCH_TIMEOUT=15
SECURITY_CHECK_TIMEOUT=8
RETEST_TIMEOUT=8
GEOIP_TIMEOUT=5
# Optional canary URL for strict security checks
#CANARY_URL=https://example.com/health

# =============================================================================
# Performance & Latency
# =============================================================================

# Latency Thresholds (milliseconds)
MIN_LATENCY=10
MAX_LATENCY=10000

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Memory Management
BATCH_SIZE=50
CACHE_TTL=1800
MAX_LINES_PER_SOURCE=0
MAX_CONFIG_LINE_LENGTH=0
MAX_SEEN_KEYS=0
MAX_B64_INPUT_SIZE=0
MAX_B64_OUTPUT_SIZE=0
MAX_SOURCE_URL_LENGTH=2048
MAX_OPENVPN_CONFIG_SIZE=0
MAX_RESPONSE_SIZE=0
FETCH_MAX_REDIRECTS=5
FETCH_BLOCK_PRIVATE_NETWORKS=true

# Worker Auto-Scaling (0 = auto-detect based on CPU cores)
MAX_WORKERS=0

# =============================================================================
# Security & Privacy
# =============================================================================

# Blocked Countries (ISO 2-letter codes, comma-separated)
BLOCKED_COUNTRIES=IR,KP,SY

# Logging Configuration
LOG_LEVEL=INFO
MASK_SENSITIVE_DATA=True

# Strict Security Mode (enables additional validation)
STRICT_SECURITY=False

# Stego key (base64 Fernet key) used to embed configs in cover images
#STEGO_KEY=your-base64-fernet-key

# Allow private/loopback IPs through validation
ALLOW_PRIVATE_IPS=true

# Require TLS-capable configs when TLS validation is enabled
TLS_TESTS_ENABLED=true

# Ignore protocol when endpoint-deduplicating (more aggressive)
DEDUP_IGNORE_PROTOCOL=false
# Enable endpoint-level deduplication (can be disabled to reduce dropouts)
ENABLE_ENDPOINT_FILTERING=true

# =============================================================================
# Database & Data Paths
# =============================================================================

# GeoIP Database Paths (download with: configstream update-databases)
GEOIP_CITY_DB_PATH=data/GeoLite2-City.mmdb
GEOIP_ASN_DB_PATH=data/GeoLite2-ASN.mmdb

# Quality Tracking Database
QUALITY_DB_PATH=data/source_quality.db

# =============================================================================
# External Services (Optional)
# =============================================================================

# Telegram Bot Configuration
#TELEGRAM_BOT_TOKEN=your-bot-token-here
#TELEGRAM_CHAT_ID=your-chat-id-here

# VirusTotal API Key (for advanced honeypot detection)
#VIRUSTOTAL_API_KEY=your-virustotal-key-here

# Optional Shadowsocks-Rust FFI validation.
# This is disabled unless a prebuilt bin/ss_checker library exists AND its
# SHA-256 is explicitly configured here. Do not treat this as a production
# security guarantee unless you build, distribute, and pin the binary yourself.
#SS_LIB_SHA256=64-character-sha256-of-local-ss-checker-binary

# =============================================================================
# Advanced Features
# =============================================================================

# Vwarp SOCKS5 Tunnel (if vwarp binary is available)
USE_VWARP_TUNNEL=true
VWARP_SOCKS5_PORT=10808
# Vwarp binary version (default: v2.2.2). Set VWARP_VERSION=v2.1.0 for older binaries (enables config sanitization).
#VWARP_VERSION=v2.2.2

# Washer / WARP Configuration
WARP_KEY_POOL=[]
INTRANET_ORIGIN=IR
OPTIMAL_RELAY_ORIGIN=IR

# Active Scanning (opt-in only)
ALLOW_ACTIVE_SCANNING=false
FORCE_SCANNER=false

# Cache Warming (pre-load high-quality proxies)
ENABLE_CACHE_WARMING=true

# Smart Chain Intelligence
ENABLE_SMART_CHAINING=true

# Anomaly Detection
ENABLE_ANOMALY_DETECTION=true

# DNS-safe output variants (IP-only subscriptions)
DNS_SAFE_OUTPUTS=true
DNS_HARDENED_OUTPUTS=true
# Fail the pipeline (exit non-zero) if 0 proxies are working.
# Default should remain false for GitHub Pages deployments (avoid missing artifacts / 404s).
FAIL_ON_ZERO_WORKING=false
DNS_SAFE_RESOLVE_TIMEOUT=4
DNS_SAFE_RESOLVE_BATCH=500
DNS_SAFE_RESOLVE_LIMIT=0

# =============================================================================
# Development & Debugging
# =============================================================================

# Debug Mode (enables verbose logging)
#DEBUG=true

# Dry Run Mode (skip actual proxy testing)
#DRY_RUN=false

# CI/CD Mode (affects build and deployment)
#CI=false
